{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:deno-fresh-app",
  "name": "Deno Fresh 岛屿架构应用 (Deno Fresh App)",
  "category": "web-frontend",
  "description": "Deno 官方 Fresh 框架仓库，默认零客户端 JavaScript，通过岛屿组件按需注水，配合 Deno KV 做边缘数据存储。",
  "author": "Deno Land",
  "license": "MIT",
  "tags": ["Deno", "Fresh", "岛屿架构", "边缘计算", "TypeScript"],
  "homepage": "https://usefresh.dev",
  "repository": "https://github.com/freshframework/fresh",
  "scaffold": {
    "type": "git-clone",
    "gitUrl": "https://github.com/freshframework/fresh.git",
    "command": "git clone https://github.com/freshframework/fresh.git {{projectName}} && cd {{projectName}}",
    "defaultDir": "fresh-app",
    "postInstallNotice": "需要先安装 Deno；仓库自带 demo/ 应用可直接运行，无需 npm install。",
    "steps": [
      {
        "id": "clone-fresh",
        "program": "git",
        "args": ["clone", "https://github.com/freshframework/fresh.git", "{{targetPath}}"],
        "cwd": "{{parentDir}}",
        "description": "克隆 Fresh 框架工程"
      }
    ],
    "supportedPackageManagers": [],
    "requiredCapabilities": ["git", "deno"],
    "preparedOnly": true
  },
  "requirements": ["git", "deno"],
  "featured": false,
  "updatedAt": "2026-10-04"
}
