{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:cookiecutter-django",
  "name": "Cookiecutter Django 生产级模板 (Cookiecutter Django)",
  "category": "backend",
  "description": "面向生产环境的 Django 项目生成器：自定义用户模型、Docker 化部署、Celery、PostgreSQL 与安全默认配置。",
  "author": "Cookiecutter Django",
  "license": "BSD-3-Clause",
  "tags": ["Django", "Cookiecutter", "PostgreSQL", "Celery", "Docker"],
  "homepage": "https://cookiecutter-django.readthedocs.io",
  "repository": "https://github.com/cookiecutter/cookiecutter-django",
  "scaffold": {
    "type": "command",
    "gitUrl": "https://github.com/cookiecutter/cookiecutter-django.git",
    "command": "git clone https://github.com/cookiecutter/cookiecutter-django.git {{projectName}} && cd {{projectName}} && pip install cookiecutter",
    "defaultDir": "cookiecutter-django",
    "postInstallNotice": "生成后用 `docker compose -f local.yml up` 起本地全栈环境，含 PostgreSQL 与 Redis。",
    "steps": [
      {
        "id": "clone-django",
        "program": "git",
        "args": ["clone", "https://github.com/cookiecutter/cookiecutter-django.git", "{{targetPath}}"],
        "cwd": "{{parentDir}}",
        "description": "克隆 Cookiecutter Django 模板代码"
      },
      {
        "id": "pip-install",
        "program": "pip",
        "args": ["install", "cookiecutter"],
        "cwd": "{{targetPath}}",
        "description": "安装 cookiecutter CLI 工具"
      }
    ],
    "supportedPackageManagers": [],
    "requiredCapabilities": ["git", "python", "docker"],
    "preparedOnly": true
  },
  "requirements": ["python", "docker", "git"],
  "featured": false,
  "updatedAt": "2026-10-04"
}
