{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:rust-axum-backend",
  "name": "Rust Axum + Tokio 高性能服务端",
  "category": "backend-api",
  "description": "基于 Tokio 生态 Axum 框架的现代 Rust Web 服务端基础脚手架，具备 Tower 中间件栈、Tracing 结构化日志与 JSON 路由契约。",
  "author": "Tokio Contributors",
  "license": "MIT",
  "tags": ["Rust", "Axum", "Tokio", "高性能API", "异步编程"],
  "homepage": "https://github.com/tokio-rs/axum",
  "repository": "https://github.com/tokio-rs/axum",
  "scaffold": {
    "type": "command",
    "command": "cargo new --bin {{projectName}} && cd {{projectName}} && cargo add axum tokio --features tokio/full && cargo add tracing tracing-subscriber serde --features serde/derive",
    "defaultDir": "my-axum-service",
    "postInstallNotice": "运行 `cargo run` 启动 Axum HTTP 服务，默认端口监听 0.0.0.0:3000。",
    "steps": [
      {
        "id": "cargo-new",
        "program": "cargo",
        "args": ["new", "--bin", "{{projectName}}"],
        "cwd": "{{parentDir}}",
        "description": "创建 Rust 独立二进制应用"
      },
      {
        "id": "add-axum",
        "program": "cargo",
        "args": ["add", "axum", "tokio", "--features", "tokio/full"],
        "cwd": "{{targetPath}}",
        "description": "添加 Axum 与 Tokio 运行时依赖"
      },
      {
        "id": "add-tracing",
        "program": "cargo",
        "args": ["add", "tracing", "tracing-subscriber", "serde", "--features", "serde/derive"],
        "cwd": "{{targetPath}}",
        "description": "添加日志追踪与 Serde 序列化库"
      }
    ],
    "supportedPackageManagers": [],
    "requiredCapabilities": ["rust"],
    "preparedOnly": true
  },
  "requirements": ["rust"],
  "featured": true,
  "updatedAt": "2026-10-03"
}
