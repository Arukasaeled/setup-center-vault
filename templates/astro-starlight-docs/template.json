{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:astro-starlight-docs",
  "name": "Starlight 文档站主题 (Astro Starlight Docs)",
  "category": "content-site",
  "description": "Astro 官方文档站主题 Starlight，内置侧栏导航、全文检索、i18n 与深色模式，开箱即用的技术文档骨架。",
  "author": "Astro Team",
  "license": "MIT",
  "tags": ["Astro", "Starlight", "文档站", "全文检索", "i18n"],
  "homepage": "https://starlight.astro.build",
  "repository": "https://github.com/withastro/starlight",
  "scaffold": {
    "type": "git-clone",
    "gitUrl": "https://github.com/withastro/starlight.git",
    "command": "git clone https://github.com/withastro/starlight.git {{projectName}} && cd {{projectName}} && pnpm install",
    "defaultDir": "starlight-docs",
    "postInstallNotice": "仓库为 monorepo，docs/ 内即为 Starlight 官方文档站实例，运行 `pnpm dev` 预览。",
    "steps": [
      {
        "id": "git-clone-starlight",
        "program": "git",
        "args": ["clone", "https://github.com/withastro/starlight.git", "{{targetPath}}"],
        "cwd": "{{parentDir}}",
        "description": "克隆 Starlight 官方文档站仓库"
      },
      {
        "id": "install-deps",
        "program": "pnpm",
        "args": ["install"],
        "cwd": "{{targetPath}}",
        "description": "安装项目工作区依赖"
      }
    ],
    "supportedPackageManagers": ["pnpm", "npm", "yarn"],
    "defaultPackageManager": "pnpm",
    "requiredCapabilities": ["git", "node", "pnpm"],
    "preparedOnly": true
  },
  "requirements": ["git", "node", "pnpm"],
  "featured": false,
  "updatedAt": "2026-10-04"
}
