{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SetupCenterReleaseCheckpointSchema",
  "description": "Schema definition for immutable Vault release checkpoints",
  "type": "object",
  "required": [
    "releaseVersion",
    "commitSha",
    "snapshotTag",
    "publishedAt",
    "summary",
    "changes",
    "collections"
  ],
  "additionalProperties": false,
  "properties": {
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Strict 40-character hexadecimal Git commit SHA for immutable pinning"
    },
    "snapshotTag": {
      "type": "string",
      "pattern": "^v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "collections": {
      "type": "object",
      "required": ["styles", "resources", "templates", "patterns"],
      "additionalProperties": false,
      "properties": {
        "styles": { "type": "integer", "minimum": 0 },
        "resources": { "type": "integer", "minimum": 0 },
        "templates": { "type": "integer", "minimum": 0 },
        "patterns": { "type": "integer", "minimum": 0 },
        "skills": { "type": "integer", "minimum": 0 },
        "inbox": { "type": "integer", "minimum": 0 }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
