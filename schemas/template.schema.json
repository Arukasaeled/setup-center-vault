{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SetupCenterTemplateSchema",
  "description": "Schema definition for starter project templates and scaffolds in Vault",
  "type": "object",
  "required": ["id", "name", "category", "description", "scaffold", "author", "tags"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "repository": { "type": "string" },
    "homepage": { "type": "string" },
    "scaffold": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["git-clone", "command", "archive-extract"] },
        "command": { "type": "string" },
        "gitUrl": { "type": "string" },
        "archiveUrl": { "type": "string" },
        "defaultDir": { "type": "string" },
        "postInstallNotice": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["program", "args"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "program": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "cwd": { "type": "string" },
              "description": { "type": "string" },
              "optional": { "type": "boolean" },
              "condition": { "type": "string" }
            }
          }
        },
        "supportedPackageManagers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "defaultPackageManager": { "type": "string" },
        "requiredCapabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preparedOnly": { "type": "boolean" },
        "targetSubdir": { "type": "string" }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "featured": { "type": "boolean" },
    "updatedAt": { "type": "string" },
    "extensions": {
      "type": "object"
    }
  }
}
