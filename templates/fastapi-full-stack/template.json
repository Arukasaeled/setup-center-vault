{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:fastapi-full-stack",
  "name": "FastAPI 全栈脚手架 (FastAPI Full Stack)",
  "category": "backend",
  "description": "FastAPI 官方全栈模板，含 SQLModel 数据层、JWT 鉴权、Alembic 迁移、Celery 任务与自动生成的 TypeScript 前端客户端。",
  "author": "FastAPI",
  "license": "MIT",
  "tags": ["FastAPI", "SQLModel", "Alembic", "Docker", "JWT"],
  "homepage": "https://fastapi.tiangolo.com",
  "repository": "https://github.com/fastapi/full-stack-fastapi-template",
  "scaffold": {
    "type": "git-clone",
    "gitUrl": "https://github.com/fastapi/full-stack-fastapi-template.git",
    "command": "git clone https://github.com/fastapi/full-stack-fastapi-template.git {{projectName}} && cd {{projectName}} && docker compose up -d",
    "defaultDir": "fastapi-fullstack",
    "postInstallNotice": "先用 `python -c \"import secrets;print(secrets.token_urlsafe(32))\"` 生成 SECRET_KEY 写入 .env。",
    "steps": [
      {
        "id": "clone-fastapi-fullstack",
        "program": "git",
        "args": ["clone", "https://github.com/fastapi/full-stack-fastapi-template.git", "{{targetPath}}"],
        "cwd": "{{parentDir}}",
        "description": "克隆 FastAPI 官方全栈模板"
      },
      {
        "id": "docker-compose-up",
        "program": "docker",
        "args": ["compose", "up", "-d"],
        "cwd": "{{targetPath}}",
        "description": "启动全栈服务容器"
      }
    ],
    "supportedPackageManagers": [],
    "requiredCapabilities": ["git", "python", "docker"],
    "preparedOnly": true
  },
  "requirements": ["git", "python", "docker"],
  "featured": true,
  "updatedAt": "2026-10-04"
}
