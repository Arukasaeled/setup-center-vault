{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:rust-cli-starter",
  "name": "Rust 现代命令行工具脚手架",
  "category": "cli",
  "description": "基于 Clap v4 派生宏、Tokio 异步运行时与 Anyhow 错误处理的 Rust 命令行工具 cargo-generate 模板。",
  "author": "thesurlydev",
  "license": "Apache-2.0",
  "tags": ["Rust", "Clap", "CLI", "Tokio", "cargo-generate"],
  "homepage": "https://github.com/thesurlydev/clap-cli-template",
  "repository": "https://github.com/thesurlydev/clap-cli-template",
  "scaffold": {
    "type": "command",
    "command": "cargo generate --git https://github.com/thesurlydev/clap-cli-template --name {{projectName}}",
    "defaultDir": "my-rust-cli",
    "postInstallNotice": "执行 `cargo run -- --help` 查看自动生成的 CLI 帮助与参数解析。"
  },
  "requirements": ["Rust toolchain (cargo, rustc 1.74+)"],
  "featured": false,
  "updatedAt": "2026-10-02"
}
