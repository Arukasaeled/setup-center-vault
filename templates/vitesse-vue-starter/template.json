{
  "$schema": "../../schemas/template.schema.json",
  "id": "tpl:vitesse-vue-starter",
  "name": "Vitesse Vue 精致起步模板 (Vitesse Vue Starter)",
  "category": "web-frontend",
  "description": "Anthony Fu 出品的 Vue 3 起步模板，集成 Vite、UnoCSS、Vue Router、Pinia、自动导入与按需组件加载。",
  "author": "Anthony Fu",
  "license": "MIT",
  "tags": ["Vue 3", "Vite", "UnoCSS", "Pinia", "起步模板"],
  "homepage": "https://github.com/antfu-collective/vitesse",
  "repository": "https://github.com/antfu-collective/vitesse",
  "scaffold": {
    "type": "git-clone",
    "gitUrl": "https://github.com/antfu-collective/vitesse.git",
    "command": "git clone https://github.com/antfu-collective/vitesse.git {{projectName}} && cd {{projectName}} && pnpm install",
    "defaultDir": "my-vitesse-app",
    "postInstallNotice": "运行 `pnpm dev` 启动开发服务器；首次运行会生成类型声明。",
    "steps": [
      {
        "id": "clone-vitesse",
        "program": "git",
        "args": ["clone", "https://github.com/antfu-collective/vitesse.git", "{{targetPath}}"],
        "cwd": "{{parentDir}}",
        "description": "克隆 Vitesse Vue 3 起步仓库"
      },
      {
        "id": "install-deps",
        "program": "pnpm",
        "args": ["install"],
        "cwd": "{{targetPath}}",
        "description": "安装 Vue 生态与 UnoCSS 依赖"
      }
    ],
    "supportedPackageManagers": ["pnpm", "npm", "yarn"],
    "defaultPackageManager": "pnpm",
    "requiredCapabilities": ["git", "node", "pnpm"],
    "preparedOnly": true
  },
  "requirements": ["git", "node", "pnpm"],
  "featured": true,
  "updatedAt": "2026-10-04"
}
